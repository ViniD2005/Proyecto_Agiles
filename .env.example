# ===== Copiar a .env y completar. NUNCA subir .env al repositorio =====

# SQL Server (una base por microservicio dentro del mismo motor)
MSSQL_SA_PASSWORD=EduMonitor#2026Dev

# RabbitMQ
RABBITMQ_USER=edumonitor
RABBITMQ_PASSWORD=edumonitor_dev

# JWT compartido entre MS-A (emisor), Gateway y servicios (validación). Mínimo 32 caracteres
JWT_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres
JWT_ISSUER=edumonitor-identity
JWT_AUDIENCE=edumonitor-clients
JWT_EXPIRATION_MINUTES=120

# Moodle propio (Docker)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin#2026Moodle
MOODLE_ADMIN_EMAIL=admin@edumonitor.local
MARIADB_PASSWORD=moodle_dev
MARIADB_ROOT_PASSWORD=moodle_root_dev

# Token del servicio web de Moodle (HU-02). Se genera en Moodle y se pega aquí
MOODLE_TOKEN=pegar-aqui-el-token-del-servicio-externo

# Contraseña inicial de los usuarios sembrados en MS-A (solo desarrollo)
SEED_DEFAULT_PASSWORD=Docente#2026
