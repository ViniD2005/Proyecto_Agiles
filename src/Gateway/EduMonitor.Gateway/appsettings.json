{
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } } },
  "AllowedHosts": "*",
  "Jwt": { "Key": "", "Issuer": "edumonitor-identity", "Audience": "edumonitor-clients" },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity", "Order": 1, "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth": {
        "ClusterId": "identity", "Order": 2, "AuthorizationPolicy": "Autenticado",
        "Match": { "Path": "/api/auth/{**resto}" }
      },
      "auditoria": {
        "ClusterId": "identity", "Order": 2, "AuthorizationPolicy": "Autenticado",
        "Match": { "Path": "/api/auditoria/{**resto}" }
      },
      "analitica-por-materia": {
        "ClusterId": "analytics", "Order": 1, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/materias/{id}/{seccion:regex(^(indicadores|riesgo|desempeno-por-tema|reporte)$)}" }
      },
      "analitica": {
        "ClusterId": "analytics", "Order": 2, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/analitica/{**resto}" }
      },
      "agente": {
        "ClusterId": "analytics", "Order": 2, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/agente/{**resto}" }
      },
      "umbrales": {
        "ClusterId": "analytics", "Order": 2, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/umbrales/{**resto}" }
      },
      "materias": {
        "ClusterId": "academic", "Order": 3, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/materias/{**resto}" }
      },
      "actividades": {
        "ClusterId": "academic", "Order": 3, "AuthorizationPolicy": "SoloDocente",
        "Match": { "Path": "/api/actividades/{**resto}" }
      },
      "moodle": {
        "ClusterId": "academic", "Order": 3, "AuthorizationPolicy": "Autenticado",
        "Match": { "Path": "/api/moodle/{**resto}" }
      }
    },
    "Clusters": {
      "identity":  { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "academic":  { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "analytics": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } }
    }
  }
}
