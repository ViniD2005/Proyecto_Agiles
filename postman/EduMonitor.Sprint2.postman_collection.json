            "url": {
              "raw": "{{gateway}}/api/materias/{{materia_id}}/calificaciones?page=1&pageSize=10",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "materias",
                "{{materia_id}}",
                "calificaciones"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Devuelve actividades y estudiantes', () => { pm.expect(j.actividades.length).to.be.above(0); pm.expect(j.estudiantes.items.length).to.be.above(0); });",
                  "const ests = ['Calificada','Cero','SinEntrega','PendienteDeCalificar'];",
                  "const estados = new Set(); j.estudiantes.items.forEach(e => Object.values(e.notas).forEach(n => estados.add(n.estado)));",
                  "pm.test('Los estados son válidos (RN-08)', () => estados.forEach(s => pm.expect(ests).to.include(s)));",
                  "if (j.estudiantes.items.length) pm.collectionVariables.set('estudiante_id', j.estudiantes.items[0].estudianteId);"
                ]
              }
            }
          ]
        }
      ]
