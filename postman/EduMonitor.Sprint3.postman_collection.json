{
  "info": {
    "name": "EduMonitor AI - Sprint 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de API del Sprint 3 (HU-13 a HU-21). Orden: Login docente1 → Agente → Recomendaciones → Reporte → Tendencia → Correo → Sílabo → Auditoría (admin) → Permisos. Ajustar materia_id (id de Programación Web en EduMonitor). Requiere haber sincronizado las calificaciones (Sprint 2)."
  },
  "item": [
    {
      "name": "0 · Autenticación",
      "item": [
        {
          "name": "Login docente1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"docente1@uta.edu.ec\", \"password\": \"{{password}}\"}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
